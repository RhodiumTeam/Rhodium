    "@vitejs/plugin-react": "6.1.2",
    "playwright-core": "1.63.0",
    "shadcn": "4.21.4",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@dagrejs/dagre": "3.1.1",
    "@larksuiteoapi/node-sdk": "1.76.0",
