{
  "name": "rhodium",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "scripts/build.sh",
    "build:web": "bun --bun vite build web",
    "check": "PATH=\"$HOME/.cargo/bin:$PATH\" cargo fmt --check --manifest-path holder/Cargo.toml && bun run typecheck && bun run test",
